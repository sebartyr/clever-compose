              "description_kind": "markdown",
              "optional": true
             }
            },
            "nesting_mode": "single"
           },
           "description": "ClamAV antivirus integration for file scanning",
           "description_kind": "markdown",
           "optional": true
          },
          "newrelic": {
           "nested_type": {
            "attributes": {
             "app_name": {
              "type": "string",
              "description": "Application name in New Relic ([NEW_RELIC_APP_NAME](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#new-relic))",
              "description_kind": "markdown",
              "optional": true
             },
             "license_key": {
              "type": "string",
              "description": "Your New Relic license key ([NEW_RELIC_LICENSE_KEY](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#new-relic))",
              "description_kind": "markdown",
              "required": true,
              "sensitive": true
             }
            },
            "nesting_mode": "single"
           },
           "description": "New Relic APM integration for application performance monitoring",
           "description_kind": "markdown",
           "optional": true
          },
          "pgpoolii": {
           "nested_type": {
            "attributes": {
             "enabled": {
              "type": "bool",
              "description": "Enable PgPool-II connection pooler ([CC_ENABLE_PGPOOL](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#pgpool-ii))",
              "description_kind": "markdown",
              "optional": true
             }
            },
            "nesting_mode": "single"
           },
           "description": "PgPool-II configuration. [Learn more](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#pgpool-ii)",
           "description_kind": "markdown",
           "optional": true
          },
          "prometheus": {
           "nested_type": {
            "attributes": {
             "password": {
              "type": "string",
              "description": "Define the password for the basic auth of the Prometheus endpoint ([CC_METRICS_PROMETHEUS_PASSWORD](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#prometheus))",
              "description_kind": "markdown",
              "optional": true,
              "sensitive": true
             },
             "path": {
              "type": "string",
              "description": "Define the path on which the Prometheus endpoint is available ([CC_METRICS_PROMETHEUS_PATH](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#prometheus)). Default: `/metrics`",
              "description_kind": "markdown",
              "optional": true
             },
             "port": {
              "type": "number",
              "description": "Define the port on which the Prometheus endpoint is available ([CC_METRICS_PROMETHEUS_PORT](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#prometheus)). Default: `9100`",
              "description_kind": "markdown",
              "optional": true
             },
             "response_timeout": {
              "type": "number",
              "description": "Define the timeout in seconds to collect the application metrics. This value must be below 60 seconds ([CC_METRICS_PROMETHEUS_RESPONSE_TIMEOUT](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#prometheus)). Default: `3`",
              "description_kind": "markdown",
              "optional": true
             },
             "user": {
              "type": "string",
              "description": "Define the user for the basic auth of the Prometheus endpoint ([CC_METRICS_PROMETHEUS_USER](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#prometheus))",
              "description_kind": "markdown",
              "optional": true
             }
            },
            "nesting_mode": "single"
           },
           "description": "Prometheus metrics integration. See [Prometheus docs](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#prometheus)",
           "description_kind": "markdown",
           "optional": true
          },
          "redirectionio": {
           "nested_type": {
            "attributes": {
             "backend_port": {
              "type": "number",
              "description": "Backend application port ([CC_REDIRECTIONIO_BACKEND_PORT](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#redirectionio))",
              "description_kind": "markdown",
              "optional": true
             },
             "instance_name": {
              "type": "string",
              "description": "Custom instance name for the Redirection.io agent ([CC_REDIRECTIONIO_INSTANCE_NAME](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#redirectionio))",
              "description_kind": "markdown",
              "optional": true
             },
             "project_key": {
              "type": "string",
              "description": "Your Redirection.io project key ([CC_REDIRECTIONIO_PROJECT_KEY](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#redirectionio))",
              "description_kind": "markdown",
              "required": true,
              "sensitive": true
             }
            },
            "nesting_mode": "single"
           },
           "description": "Redirection.io integration for URL redirection and traffic management. See [Redirection.io docs](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#redirectionio)",
           "description_kind": "markdown",
           "optional": true
          },
          "varnish": {
           "nested_type": {
            "attributes": {
             "config_file": {
              "type": "string",
              "description": "Path to the Varnish configuration file, relative to your application root ([CC_VARNISH_FILE](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#varnish)). Default: `/clevercloud/varnish.vcl`",
              "description_kind": "markdown",
              "optional": true
             },
             "storage_size": {
              "type": "string",
              "description": "Configure the size of the Varnish cache ([CC_VARNISH_STORAGE_SIZE](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#varnish)). Default: `1G`",
              "description_kind": "markdown",
              "optional": true
             }
            },
            "nesting_mode": "single"
           },
           "description": "Varnish cache integration for HTTP acceleration. See [Varnish docs](https://www.clever.cloud/developers/doc/reference/reference-environment-variables#varnish)",
           "description_kind": "markdown",
           "optional": true
          }
         },
         "nesting_mode": "single"
        },
        "description": "Third-party integrations configuration",
        "description_kind": "markdown",
        "optional": true
       },
       "ipv6_cidr": {
        "type": "string",
        "description": "Activate the support of IPv6 with an IPv6 subnet int the docker daemon",
        "description_kind": "markdown",
        "optional": true
       },
       "max_instance_count": {
        "type": "number",
        "description": "Maximum instance count, if different from min value, enable auto-scaling",
        "description_kind": "markdown",
        "required": true
       },
       "min_instance_count": {
        "type": "number",
        "description": "Minimum instance count",
        "description_kind": "markdown",
        "required": true
       },
       "name": {
        "type": "string",
        "description": "Application name",
        "description_kind": "markdown",
        "required": true
       },
       "networkgroups": {
        "nested_type": {
         "attributes": {
          "fqdn": {
           "type": "string",
