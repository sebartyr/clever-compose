        "description_kind": "markdown",
        "optional": true
       },
       "dependencies": {
        "type": [
         "set",
         "string"
        ],
        "description": "A list of application or add-ons required to run this application.\nCan be either app_xxx or postgres_yyy ID format",
        "description_kind": "markdown",
        "optional": true
       },
       "deploy_url": {
        "type": "string",
        "description": "Git URL used to push source code",
        "description_kind": "markdown",
        "computed": true
       },
       "description": {
        "type": "string",
        "description": "Application description",
        "description_kind": "markdown",
        "optional": true
       },
       "dockerfile": {
        "type": "string",
        "description": "The name of the Dockerfile to build",
        "description_kind": "markdown",
        "optional": true
       },
       "enable_ipv6": {
        "type": "bool",
        "description_kind": "plain",
        "deprecated": true,
        "optional": true
       },
       "environment": {
        "type": [
         "map",
         "string"
        ],
        "description": "Environment variables injected into the application.\n\n**Note:** Null values are not allowed. To conditionally include variables, use a for expression:\n```hcl\nenvironment = { for k, v in {\n  VAR1 = \"value\"\n  VAR2 = var.optional_var\n} : k => v if v != null }\n```",
        "description_kind": "markdown",
        "optional": true,
        "sensitive": true
       },
       "exposed_environment": {
        "type": [
         "map",
         "string"
        ],
        "description": "Environment variables other linked applications will be able to use",
        "description_kind": "plain",
        "optional": true,
        "sensitive": true
       },
       "id": {
        "type": "string",
        "description": "Unique identifier generated during application creation",
        "description_kind": "markdown",
        "computed": true
       },
       "integrations": {
        "nested_type": {
         "attributes": {
          "clamav": {
           "nested_type": {
            "attributes": {
             "enabled": {
