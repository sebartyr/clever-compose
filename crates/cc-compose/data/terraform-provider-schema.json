        "description_kind": "markdown",
        "optional": true
       },
       "region": {
        "type": "string",
        "description": "Geographical region where the database will be deployed",
        "description_kind": "markdown",
        "optional": true,
        "computed": true
       },
       "registry_password": {
        "type": "string",
        "description": "The password of your username",
        "description_kind": "markdown",
        "optional": true,
        "sensitive": true
       },
       "registry_url": {
        "type": "string",
        "description": "The server of your private registry (optional).\tDocker\u2019s public registry",
        "description_kind": "markdown",
        "optional": true
       },
       "registry_user": {
        "type": "string",
        "description": "The username to login to a private registry",
        "description_kind": "markdown",
        "optional": true
       },
       "smallest_flavor": {
        "type": "string",
        "description": "Smallest instance flavor",
        "description_kind": "markdown",
        "required": true
       },
       "sticky_sessions": {
        "type": "bool",
        "description": "Enable sticky sessions, use it when your client sessions are instances scoped",
        "description_kind": "markdown",
        "optional": true,
        "computed": true
       },
       "vhosts": {
        "nested_type": {
         "attributes": {
          "fqdn": {
           "type": "string",
           "description": "Fully qualified domain name",
           "description_kind": "markdown",
           "required": true
          },
          "path_begin": {
           "type": "string",
           "description": "Any HTTP request starting with this path will be sent to this application",
           "description_kind": "markdown",
           "optional": true,
           "computed": true
          }
         },
         "nesting_mode": "set"
        },
        "description": "List of virtual hosts",
        "description_kind": "markdown",
        "optional": true,
        "computed": true
       }
      },
      "block_types": {
       "deployment": {
        "nesting_mode": "single",
        "block": {
         "attributes": {
          "authentication_basic": {
           "type": "string",
           "description": "user ans password ':' separated, (PersonalAccessToken in Github case)",
           "description_kind": "markdown",
           "optional": true,
           "sensitive": true
          },
          "commit": {
           "type": "string",
           "description": "Support multiple syntax like `refs/heads/[BRANCH]`, `github_hook` or `[COMMIT]`, when using the special value `github_hook`, we will link the application to the Github repository",
           "description_kind": "markdown",
           "optional": true
          },
          "repository": {
           "type": "string",
           "description": "The repository URL to deploy, can be 'https://...', 'file://...'",
           "description_kind": "markdown",
           "optional": true
          }
         },
         "description_kind": "plain"
        }
       },
       "hooks": {
        "nesting_mode": "single",
        "block": {
         "attributes": {
          "post_build": {
           "type": "string",
           "description": "[CC_POST_BUILD_HOOK](https://www.clever.cloud/developers/doc/develop/build-hooks/#post-build)",
           "description_kind": "markdown",
           "optional": true
          },
          "pre_build": {
           "type": "string",
           "description": "[CC_PRE_BUILD_HOOK](https://www.clever.cloud/developers/doc/develop/build-hooks/#pre-build)",
           "description_kind": "markdown",
           "optional": true
          },
          "pre_run": {
           "type": "string",
           "description": "[CC_PRE_RUN_HOOK](https://www.clever.cloud/developers/doc/develop/build-hooks/#pre-run)",
           "description_kind": "markdown",
           "optional": true
          },
          "run_failed": {
           "type": "string",
           "description": "[CC_RUN_FAILED_HOOK](https://www.clever.cloud/developers/doc/develop/build-hooks/#run-successfail)",
           "description_kind": "markdown",
           "optional": true
          },
          "run_succeed": {
           "type": "string",
           "description": "[CC_RUN_SUCCEEDED_HOOK](https://www.clever.cloud/developers/doc/develop/build-hooks/#run-successfail)",
           "description_kind": "markdown",
           "optional": true
          }
         },
         "description_kind": "plain"
        }
       }
      },
      "description": "Manage [Docker](https://www.docker.com/) applications.\n\nSee [Docker product specification](https://www.clever.cloud/developers/doc/applications/docker).\n\n**Note**: For deploying from private GitHub repositories, see the [private repository deployment guide](https://registry.terraform.io/providers/CleverCloud/clevercloud/latest/docs#applications-private-repository-deployment).\n",
      "description_kind": "markdown"
     }
    },
