    },
    {
      "resource": "addon",
      "id": "addon/db",
      "service": "db",
      "name": "gitea-db",
      "provider": "postgresql-addon",
      "plan": "xxs_sml",
      "region": "par",
      "version": "17",
      "tags": [
        "compose-project=gitea",
        "compose-service=db",
        "compose-spec=9aa14d857c9c7c91984add8639f6f607"
