      "private": true
    },
    {
      "resource": "app",
      "id": "app/gitea",
      "service": "gitea",
      "name": "gitea-gitea",
      "kind": "service",
      "region": "par",
      "scaling": {
        "min_flavor": "XS",
        "max_flavor": "XS",
        "min_instances": 1,
        "max_instances": 1
      },
      "source": {
        "type": "synthetic",
        "image": "gitea/gitea:latest",
        "private_registry": false,
        "files": []
      },
      "image": {
        "entrypoint": [
          "/usr/bin/entrypoint"
        ],
        "cmd": [
          "/usr/bin/s6-svscan",
          "/etc/s6"
        ],
        "user": null,
        "workdir": "/",
        "exposed_ports": [
          22,
          3000
        ]
      },
      "shim": {
        "argv": [
          "/usr/bin/entrypoint",
          "/usr/bin/s6-svscan",
          "/etc/s6"
        ],
        "workdir": "/",
        "port": {
          "mode": "forward",
          "target_port": 3000
        },
        "volumes": [
          "/data"
        ]
      },
      "env": [
        {
          "key": "CLEVER_COMPOSE_DNS_MAP",
          "value": [
            {
              "literal": "db="
            },
            {
              "ref": {
                "ref": "member_fqdn",
                "member": "member/db@default"
              }
            }
          ]
        },
        {
          "key": "CLEVER_COMPOSE_EXPAND",
          "value": [
            {
              "literal": "DB_NAME,DB_USER,DB_PASSWD"
            }
          ]
        },
        {
          "key": "DB_HOST",
          "value": [
            {
              "ref": {
                "ref": "member_fqdn",
                "member": "member/db@default"
              }
            },
            {
              "literal": ":8080"
            }
          ]
        },
        {
          "key": "DB_NAME",
          "value": [
            {
              "ref": {
                "ref": "addon_env",
                "addon": "addon/db",
                "var": "POSTGRESQL_ADDON_DB"
              }
            }
          ]
        },
        {
          "key": "DB_PASSWD",
          "value": [
            {
              "ref": {
                "ref": "addon_env",
                "addon": "addon/db",
                "var": "POSTGRESQL_ADDON_PASSWORD"
              }
            }
          ]
        },
        {
          "key": "DB_TYPE",
          "value": [
            {
              "literal": "postgres"
            }
          ]
        },
        {
          "key": "DB_USER",
          "value": [
            {
              "ref": {
                "ref": "addon_env",
                "addon": "addon/db",
                "var": "POSTGRESQL_ADDON_USER"
              }
            }
          ]
        },
        {
          "key": "POSTGRESQL_ADDON_NG_HOST",
          "value": [
            {
              "ref": {
                "ref": "member_fqdn",
                "member": "member/db@default"
              }
            }
          ]
        },
        {
          "key": "POSTGRESQL_ADDON_NG_PORT",
          "value": [
            {
              "literal": "8080"
            }
          ]
        }
      ],
      "depends_on": [
        "addon/db"
      ],
      "health_check_path": null,
      "tags": [
        "compose-project=gitea",
        "compose-service=gitea",
        "compose-spec=9aa14d857c9c7c91984add8639f6f607"
      ]
    },
    {
      "resource": "membership",
      "id": "member/gitea@default",
      "member": "app/gitea",
      "group": "ng/default",
      "aliases": [
        "gitea"
      ]
    },
    {
      "resource": "membership",
      "id": "member/db@default",
      "member": "addon/db",
      "group": "ng/default",
      "aliases": [
        "db"
      ]
    }
  ]
