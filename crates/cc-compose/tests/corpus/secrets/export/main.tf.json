{
  "provider": {
    "clevercloud": {
      "organisation": "${var.organisation}"
    }
  },
  "resource": {
    "clevercloud_docker": {
      "app": {
        "biggest_flavor": "XS",
        "deployment": {
          "commit": "refs/heads/clever-compose/app",
          "repository": "${var.repository}"
        },
        "environment": {
          "CC_COMPOSE_SECRET_API_TOKEN": "${var.secret_api_token}",
          "CC_COMPOSE_SECRET_DB_PASSWORD": "${file(\"${path.module}/../db_password.txt\")}",
          "DB_PASSWORD_FILE": "/run/secrets/db_password"
        },
        "max_instance_count": 1,
        "min_instance_count": 1,
        "name": "secrets-app",
        "networkgroups": [
          {
            "fqdn": "app.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud",
            "networkgroup_id": "${clevercloud_networkgroup.default.id}"
          }
        ],
        "region": "par",
        "smallest_flavor": "XS"
      }
    },
    "clevercloud_networkgroup": {
      "default": {
        "name": "secrets-default",
        "tags": [
          "compose-project=secrets",
          "compose-network=default",
          "compose-spec=146d3418d2188ff3c87af2b66be889bc"
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "clevercloud": {
        "source": "CleverCloud/clevercloud",
        "version": "~> 2.1"
      }
    }
  },
  "variable": {
    "organisation": {
      "description": "Organisation Clever Cloud (orga_xxx ou user_xxx)",
      "sensitive": true,
      "type": "string"
    },
    "repository": {
      "description": "Dépôt git qui héberge les branches clever-compose/<service> (dépôts synthétiques poussés par `clever-compose export`)",
      "type": "string"
    },
    "secret_api_token": {
      "description": "Valeur du secret `api_token` (variable d'environnement API_TOKEN au moment du up)",
      "sensitive": true,
      "type": "string"
    }
  }
}
