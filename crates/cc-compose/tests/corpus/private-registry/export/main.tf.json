{
  "terraform": {
    "required_providers": {
      "clevercloud": {
        "source": "CleverCloud/clevercloud",
        "version": "~> 2.2"
      }
    }
  },
  "provider": {
    "clevercloud": {
      "organisation": "${var.organisation}"
    }
  },
  "variable": {
    "organisation": {
      "type": "string",
      "description": "Organisation Clever Cloud (orga_xxx ou user_xxx)",
      "sensitive": true
    },
    "repository": {
      "type": "string",
      "description": "Dépôt git qui porte les branches clever-compose/<service> (écrites par `clever-compose export --branches`) : URL distante, ou `file:///chemin/local` (ouvert sur place par le provider)"
    },
    "registry_ghcr_io_user": {
      "type": "string",
      "sensitive": true,
      "description": "Utilisateur du registre ghcr.io"
    },
    "registry_ghcr_io_password": {
      "type": "string",
      "sensitive": true,
      "description": "Mot de passe du registre ghcr.io"
    }
  },
  "resource": {
    "clevercloud_networkgroup": {
      "default": {
        "name": "private-registry-default",
        "tags": [
          "compose-project=private-registry",
          "compose-network=default",
          "compose-spec=2e1635890a217ca2cfc876398bf542ca"
        ]
      }
    },
    "clevercloud_elasticsearch": {
      "search": {
        "name": "private-registry-search",
        "plan": "xs",
        "region": "par",
        "version": "8",
        "networkgroups": [
          {
            "networkgroup_id": "${clevercloud_networkgroup.default.id}",
            "fqdn": "search.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud"
          }
        ]
      }
    },
    "clevercloud_docker": {
      "app": {
        "name": "private-registry-app",
        "region": "par",
        "smallest_flavor": "XS",
        "biggest_flavor": "XS",
        "min_instance_count": 1,
        "max_instance_count": 1,
        "registry_url": "ghcr.io",
        "registry_user": "${var.registry_ghcr_io_user}",
        "registry_password": "${var.registry_ghcr_io_password}",
        "environment": {
          "CLEVER_COMPOSE_DNS_MAP": "search=${clevercloud_elasticsearch.search.id}.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud",
          "CLEVER_COMPOSE_EXPAND": "ES_URL",
          "ES_ADDON_NG_HOST": "${clevercloud_elasticsearch.search.id}.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud",
          "ES_ADDON_NG_PORT": "8080",
          "ES_URL": "http://$${ES_ADDON_USER}:$${ES_ADDON_PASSWORD}@${clevercloud_elasticsearch.search.id}.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud:8080"
        },
        "networkgroups": [
          {
            "networkgroup_id": "${clevercloud_networkgroup.default.id}",
            "fqdn": "app.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud"
          }
        ],
        "deployment": {
          "repository": "${var.repository}",
          "commit": "refs/heads/clever-compose/app"
        },
        "dependencies": [
          "${clevercloud_elasticsearch.search.id}"
        ]
      }
    }
  }
}
