{
  "terraform": {
    "required_providers": {
      "clevercloud": {
        "source": "CleverCloud/clevercloud",
        "version": "~> 2.1"
      }
    }
  },
  "provider": {
    "clevercloud": {
      "organisation": "${var.organisation}"
    }
  },
  "variable": {
    "organisation": {
      "type": "string",
      "description": "Organisation Clever Cloud (orga_xxx ou user_xxx)",
      "sensitive": true
    },
    "repository": {
      "type": "string",
      "description": "Dépôt git qui héberge les branches clever-compose/<service> (dépôts synthétiques poussés par `clever-compose export`)"
    }
  },
  "resource": {
    "clevercloud_networkgroup": {
      "default": {
        "name": "nextcloud-default",
        "tags": [
          "compose-project=nextcloud",
          "compose-network=default",
          "compose-spec=a8756149457c4f7cfba9e5a2388e71c4"
        ]
      }
    },
    "clevercloud_docker": {
      "nc": {
        "name": "nextcloud-nc",
        "region": "par",
        "smallest_flavor": "XS",
        "biggest_flavor": "XS",
        "min_instance_count": 1,
        "max_instance_count": 1,
        "environment": {
          "CC_COMPOSE_DNS_MAP": "db=${clevercloud_docker.db.id}.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud",
          "POSTGRES_DB": "nextcloud",
          "POSTGRES_HOST": "${clevercloud_docker.db.id}.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud",
          "POSTGRES_PASSWORD": "nextcloud",
          "POSTGRES_USER": "nextcloud"
        },
        "networkgroups": [
          {
            "networkgroup_id": "${clevercloud_networkgroup.default.id}",
            "fqdn": "nc.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud"
          }
        ],
        "deployment": {
          "repository": "${var.repository}",
          "commit": "refs/heads/clever-compose/nc"
        }
      },
      "db": {
        "name": "nextcloud-db",
        "region": "par",
        "smallest_flavor": "XS",
        "biggest_flavor": "XS",
        "min_instance_count": 1,
        "max_instance_count": 1,
        "environment": {
          "POSTGRES_DB": "nextcloud",
          "POSTGRES_PASSWORD": "nextcloud",
          "POSTGRES_USER": "nextcloud"
        },
        "networkgroups": [
          {
            "networkgroup_id": "${clevercloud_networkgroup.default.id}",
            "fqdn": "db.m.${clevercloud_networkgroup.default.id}.cc-ng.cloud"
          }
        ],
        "deployment": {
          "repository": "${var.repository}",
          "commit": "refs/heads/clever-compose/db"
        }
      }
    }
  }
}
