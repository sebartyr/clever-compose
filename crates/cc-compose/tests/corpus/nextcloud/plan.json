              }
            }
          ]
        },
        {
          "key": "POSTGRES_HOST",
          "value": [
            {
              "ref": {
                "ref": "member_fqdn",
                "member": "member/db@default"
              }
            }
          ]
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": [
            {
              "ref": {
                "ref": "addon_env",
                "addon": "addon/db",
                "var": "POSTGRESQL_ADDON_PASSWORD"
              }
            }
          ]
        },
        {
          "key": "POSTGRES_USER",
          "value": [
            {
              "ref": {
                "ref": "addon_env",
                "addon": "addon/db",
                "var": "POSTGRESQL_ADDON_USER"
              }
            }
          ]
        }
